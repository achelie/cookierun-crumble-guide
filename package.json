{
  "name": "cookierun-crumble-guide",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/verify-i18n.mjs && next build && node scripts/verify-i18n-rendered.mjs && node scripts/prepare-cloudflare-static.mjs",
    "start": "wrangler dev",
    "test": "vitest run",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "verify:i18n:rendered": "node scripts/verify-i18n-rendered.mjs",
    "test:watch": "vitest",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@iconify-icons/lucide": "^1.2.80",
    "@iconify/react": "^6.0.2",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.544.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "acorn": "8.18.0",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11",
    "wrangler": "4.124.0"
  }
}
