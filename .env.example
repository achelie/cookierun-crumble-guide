# Development previews slots by default. Set false to hide previews too.
# NEXT_PUBLIC_ADSENSE_ENABLED=false
# Set both to true for a production build only after the account checks in docs/adsense.md.
# NEXT_PUBLIC_ADSENSE_ENABLED=true
# NEXT_PUBLIC_ADSENSE_GOOGLE_CMP_READY=true

# Defaults match the publisher and ad units supplied for cookieruncrumbles.com.
# NEXT_PUBLIC_ADSENSE_PUBLISHER=ca-pub-7443237558968985
# NEXT_PUBLIC_ADSENSE_DISPLAY=6498064854
# NEXT_PUBLIC_ADSENSE_IN_ARTICLE=2512707489
# NEXT_PUBLIC_ADSENSE_DISABLED_SLOTS=home-after-browse,guide-after-answer
# NEXT_PUBLIC_ADSENSE_SLOT_OVERRIDES=placement=,other-placement=

# Teams defaults to inline. Sidebar replaces the sixth-team slot on wide screens.
# NEXT_PUBLIC_ADSENSE_COOKIE_SIDEBAR=true
# NEXT_PUBLIC_ADSENSE_TIER_SIDEBAR=true
# NEXT_PUBLIC_ADSENSE_TEAMS_SECOND=inline
# NEXT_PUBLIC_ADSENSE_GUIDE_SECOND=inline
