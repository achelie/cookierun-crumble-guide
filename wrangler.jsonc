{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cookierun-crumble-guide",
  "workers_dev": true,
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
